{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nomphi Task State",
  "type": "object",
  "required": [
    "task_id",
    "project_id",
    "title",
    "risk",
    "state",
    "iterations",
    "history"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "risk": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "state": {
      "type": "string"
    },
    "iterations": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "from",
          "to",
          "reason"
        ]
      }
    }
  }
}
